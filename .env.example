# Copy to .env and fill in. Real keys never get committed; this file lists names only.

# --- Hub ---
HUB_ID=hub-L38
HUB_DB=hub.db
HUB_PORT=8000
# Comma-separated URLs of peer hubs to sync with
HUB_PEERS=
# Link simulation: bytes per second between hubs (0 = unlimited)
LINK_BANDWIDTH_BPS=0

# --- Local AI (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Cloud fallback (online mirror only) ---
# Set to "gemini" on the online mirror only; hubs stay on local Ollama
CLOUD_PROVIDER=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Compression fact check (Upgrade 2) ---
# Download once with: hub/.venv/bin/python hub/scripts/download_nli.py
NLI_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# --- Web ---
NEXT_PUBLIC_HUB_URL=http://localhost:8000
